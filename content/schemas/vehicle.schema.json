{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vehicle.schema.json",
  "title": "Vehicle design",
  "description": "A vehicle built from catalog parts, as a tree: the first part is the root, every other part names its parent and how it is attached. Vehicle frame: forward -Z, up +Y, right +X. Loaded by sim_vehicle::design, which checks that parts, parents and nodes exist and that joined nodes meet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "parts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "part",
          "position_m"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "The part's name within this vehicle (unique)."
          },
          "part": {
            "type": "string",
            "description": "Catalog part id."
          },
          "position_m": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Rotation in degrees about the vehicle's X, then Y, then Z axes (fixed axes). Defaults to [0, 0, 0]."
          },
          "parent": {
            "type": "string",
            "description": "The part this one is attached to; omitted only for the root part (the first)."
          },
          "attach": {
            "description": "How it joins its parent: node to node, or anywhere on (or inside) the parent's surface.",
            "oneOf": [
              {
                "const": "surface"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node",
                  "to"
                ],
                "properties": {
                  "node": {
                    "type": "string",
                    "description": "This part's attach node."
                  },
                  "to": {
                    "type": "string",
                    "description": "The parent's attach node."
                  }
                }
              }
            ]
          },
          "symmetry": {
            "type": "string",
            "description": "Parts with the same symmetry group were placed together by a symmetry tool and are edited together."
          }
        },
        "dependentRequired": {
          "parent": [
            "attach"
          ],
          "attach": [
            "parent"
          ]
        }
      }
    },
    "poses": {
      "type": "object",
      "description": "Named joint poses: pose name -> joint part id -> angle in degrees (task 3.10). Joints not named go back to rest.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    }
  }
}
