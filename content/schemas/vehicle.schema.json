{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vehicle.schema.json",
  "title": "Vehicle design",
  "description": "A vehicle built from catalog parts. Vehicle frame: forward -Z, up +Y, right +X. Loaded by sim_vehicle::design, which checks that every part exists in the catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "parts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "position_m"
        ],
        "properties": {
          "part": {
            "type": "string",
            "description": "Catalog part id."
          },
          "position_m": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Rotation in degrees about the vehicle's X, then Y, then Z axes (fixed axes). Defaults to [0, 0, 0]."
          }
        }
      }
    }
  }
}
