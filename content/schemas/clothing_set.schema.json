{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clothing_set.schema.json",
  "title": "Clothing set",
  "description": "A culture's people, assembled offline (tools/build-characters.sh) from character packs into assets/export/characters/<id>/ (a .glb per character with the shared animations and a generated set.json).",
  "type": "object",
  "required": [
    "id",
    "characters"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "body",
          "roles"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "body": {
            "enum": [
              "male",
              "female"
            ]
          },
          "outfit": {
            "type": "string",
            "description": "An outfit of the fantasy outfits pack; without one the body wears its suit."
          },
          "hair": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hair_colour": {
            "$ref": "#/$defs/colour"
          },
          "suit": {
            "type": "object",
            "required": [
              "suit",
              "gloves",
              "boots"
            ],
            "additionalProperties": false,
            "properties": {
              "suit": {
                "$ref": "#/$defs/colour"
              },
              "gloves": {
                "$ref": "#/$defs/colour"
              },
              "boots": {
                "$ref": "#/$defs/colour"
              }
            }
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Role ids (the culture's) this character is chosen for."
          },
          "outfit_colour": {
            "$ref": "#/$defs/colour",
            "description": "Multiplies the outfit's colours (dyed cloth)."
          }
        }
      }
    }
  },
  "$defs": {
    "colour": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Linear RGB."
    }
  }
}
