{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "part.schema.json",
  "title": "Part catalog",
  "description": "A file of vehicle part types. Thrusters push the vehicle along their local +Y axis. Loaded by sim_vehicle::catalog; ids must be unique across all catalog files. Function data (mass, shape, kind blocks, nodes) drives the simulation; form only affects looks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parts"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "size_m"
          ],
          "properties": {
            "type": {
              "const": "box"
            },
            "size_m": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "radius_m",
            "length_m"
          ],
          "description": "Cylinder along the part's local Y axis.",
          "properties": {
            "type": {
              "const": "cylinder"
            },
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "radius_m"
          ],
          "properties": {
            "type": {
              "const": "sphere"
            },
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "profile_m",
            "arc_deg",
            "thickness_m"
          ],
          "description": "A curved shell (procedural): part of a surface of revolution about the part's Y axis, its side profile a smooth curve through four (height, radius) points top to bottom, spanning the azimuths arc_deg (0 along +Z, 90 along -X). Collides as tiles following the surface.",
          "properties": {
            "type": {
              "const": "shell"
            },
            "profile_m": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "arc_deg": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "thickness_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "mass_kg",
        "shape"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "cockpit",
            "hull",
            "tank",
            "thruster",
            "reaction_wheel",
            "cruise_drive",
            "landing_leg",
            "wheel",
            "battery",
            "structure",
            "joint"
          ]
        },
        "mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "thruster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_thrust_n"
          ],
          "properties": {
            "max_thrust_n": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "reaction_wheel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_torque_nm"
          ],
          "properties": {
            "max_torque_nm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "cruise_drive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_speed_ms"
          ],
          "properties": {
            "max_speed_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "description": {
          "type": "string"
        },
        "attach_nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attach_node"
          }
        },
        "surface_attach": {
          "type": "boolean",
          "description": "Whether the part can be attached to another part's surface (anywhere, not only at nodes). Defaults to true."
        },
        "control": {
          "type": "boolean",
          "description": "A control source (cockpit or probe core): a vehicle needs at least one. Defaults to true for cockpits."
        },
        "collider": {
          "$ref": "#/$defs/shape",
          "description": "Collision shape if different from the mass shape."
        },
        "connectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connector"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "form": {
          "$ref": "#/$defs/form"
        },
        "interior": {
          "$ref": "#/$defs/interior"
        },
        "tank": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity_kg"
          ],
          "properties": {
            "capacity_kg": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "description": "Fuel capacity (consumption from Batch 4)."
        },
        "battery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity_wh"
          ],
          "properties": {
            "capacity_wh": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "description": "Stored energy (consumption from Batch 4)."
        },
        "landing_leg": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length_m",
            "foot_radius_m"
          ],
          "description": "A leg reaching down along the part's local -Y axis to a foot.",
          "properties": {
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "foot_radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stiffness_n_per_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "damping_n_s_per_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "wheel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius_m",
            "width_m",
            "suspension_m",
            "stiffness_n_per_m",
            "damping_n_s_per_m",
            "max_motor_torque_nm",
            "max_brake_torque_nm",
            "friction"
          ],
          "description": "A driven wheel on suspension along the part's local -Y axis, rolling forward along -Z (task 3.5).",
          "properties": {
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "suspension_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stiffness_n_per_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "damping_n_s_per_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_motor_torque_nm": {
              "type": "number",
              "minimum": 0
            },
            "max_steer_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "max_brake_torque_nm": {
              "type": "number",
              "minimum": 0
            },
            "friction": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "joint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "axis",
            "max_torque_nm"
          ],
          "description": "A hinge, rotor or slider: parts attached beyond its \"end\" node turn about the axis (part axes) through that node, or (a slider) slide along it. Joint parts need \"base\" and \"end\" nodes. Hinges and rotors need speed_deg_s; sliders need limits_m and speed_m_s.",
          "properties": {
            "type": {
              "enum": [
                "hinge",
                "rotor",
                "slider"
              ]
            },
            "axis": {
              "$ref": "#/$defs/vec3"
            },
            "limits_deg": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Hinge limits (degrees)."
            },
            "speed_deg_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_torque_nm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Strongest torque (N m); for a slider, its strongest force (N)."
            },
            "limits_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Slider limits (metres)."
            },
            "speed_m_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "thruster"
              }
            }
          },
          "then": {
            "required": [
              "thruster"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reaction_wheel"
              }
            }
          },
          "then": {
            "required": [
              "reaction_wheel"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cruise_drive"
              }
            }
          },
          "then": {
            "required": [
              "cruise_drive"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "landing_leg"
              }
            }
          },
          "then": {
            "required": [
              "landing_leg"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wheel"
              }
            }
          },
          "then": {
            "required": [
              "wheel"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "battery"
              }
            }
          },
          "then": {
            "required": [
              "battery"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "joint"
              }
            }
          },
          "then": {
            "required": [
              "joint"
            ]
          }
        }
      ]
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "size_class": {
      "enum": [
        "tiny",
        "small",
        "medium",
        "large",
        "huge"
      ],
      "description": "Size class of nodes, connectors and slots: only matching sizes join."
    },
    "attach_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position_m",
        "direction",
        "size"
      ],
      "description": "A point where another part's node can join this one: position and outward direction in part axes.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "position_m": {
          "$ref": "#/$defs/vec3"
        },
        "direction": {
          "$ref": "#/$defs/vec3"
        },
        "size": {
          "$ref": "#/$defs/size_class"
        }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position_m",
        "direction",
        "size",
        "profile"
      ],
      "description": "A structural connector for sections and modules (ships-stations-interiors \u00a73.2): joins only the same size and profile; may carry an interior passage.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "position_m": {
          "$ref": "#/$defs/vec3"
        },
        "direction": {
          "$ref": "#/$defs/vec3"
        },
        "size": {
          "$ref": "#/$defs/size_class"
        },
        "profile": {
          "type": "string",
          "description": "Shape of the joint face, e.g. round, square, wedge."
        },
        "passage": {
          "enum": [
            "none",
            "hatch",
            "door",
            "corridor",
            "vehicle_ramp"
          ],
          "description": "Interior passage through the connector (defaults to none)."
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "size"
      ],
      "description": "A loadout slot on a hull (capital ships, Batch 11): what can be fitted where.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "engine",
            "weapon",
            "hangar",
            "module",
            "utility"
          ]
        },
        "size": {
          "$ref": "#/$defs/size_class"
        },
        "position_m": {
          "$ref": "#/$defs/vec3"
        },
        "direction": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "description": "How the part looks (never affects the simulation): a visual model id, its material slots and its style family.",
      "properties": {
        "model": {
          "type": "string"
        },
        "material_slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": {
          "type": "string"
        }
      }
    },
    "interior": {
      "type": "object",
      "additionalProperties": false,
      "description": "Interior definition (ships-stations-interiors \u00a75.1). In the format from Batch 3; used when walking inside ships arrives.",
      "properties": {
        "spaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "description": "e.g. cockpit, corridor, cargo_bay, bunk"
              },
              "size_m": {
                "$ref": "#/$defs/vec3"
              },
              "position_m": {
                "$ref": "#/$defs/vec3"
              }
            }
          }
        },
        "properties": {
          "type": "object",
          "description": "Gravity, air volume, capacity and so on (free form for now)."
        }
      }
    }
  }
}
