{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "star_system.schema.json",
  "title": "Star system",
  "description": "A star system: one star plus planets and moons on Kepler orbits. Units are in field names (km, deg, hours, m/s²). Loaded by sim_core::system, which also checks cross-field rules (unique ids, parents exist, moons inside their parent's sphere of influence, orbits clear of their parent).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "bodies"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "bodies": {
      "description": "The star first, then every other body. Exactly one body (the star) has no parent.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/body"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "radius_km",
        "surface_gravity_ms2",
        "rotation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "star",
            "rocky",
            "gas_giant"
          ]
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "radius_km": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Mean radius; cloud-top radius for gas giants."
        },
        "surface_gravity_ms2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Gravity at radius_km; defines the body's gravitational parameter."
        },
        "orbit": {
          "$ref": "#/$defs/orbit"
        },
        "rotation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tidally_locked"
              ],
              "properties": {
                "tidally_locked": {
                  "const": true
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "period_hours"
              ],
              "properties": {
                "period_hours": {
                  "type": "number",
                  "not": {
                    "const": 0
                  },
                  "description": "Sidereal rotation period in real hours; negative for retrograde."
                },
                "axial_tilt_deg": {
                  "type": "number"
                },
                "phase_deg": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "atmosphere": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height_km",
            "surface_pressure_atm",
            "color_rgb"
          ],
          "properties": {
            "height_km": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "surface_pressure_atm": {
              "type": "number",
              "minimum": 0
            },
            "color_rgb": {
              "$ref": "#/$defs/rgb"
            }
          }
        },
        "appearance": {
          "description": "How the body looks from a distance; engine-neutral parameters a renderer interprets.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colors"
          ],
          "properties": {
            "colors": {
              "description": "Low and high terrain colors (rocky) or band colors (gas giant), linear RGB.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/rgb"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "ocean_color": {
              "$ref": "#/$defs/rgb"
            },
            "polar_ice": {
              "description": "Fraction of the pole-to-equator range covered by ice caps.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "glow_color": {
              "description": "Self-emitted light: the star's color, or glowing lava.",
              "$ref": "#/$defs/rgb"
            }
          }
        },
        "terrain": {
          "description": "Solid-surface terrain parameters (rocky bodies only), interpreted by the terrain generator.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "relief_km"
          ],
          "properties": {
            "seed": {
              "description": "Terrain noise seed.",
              "type": "integer",
              "minimum": 0
            },
            "relief_km": {
              "description": "Height of the tallest mountains above sea level.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ocean_depth_km": {
              "description": "Depth of the deepest ocean floor below sea level.",
              "type": "number",
              "minimum": 0
            },
            "ocean_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Fraction of the surface below sea level."
            },
            "mountains": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "How much of the land carries mountain ranges."
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Strength of hills and small-scale relief."
            },
            "craters": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Crater density (airless bodies)."
            }
          }
        },
        "climate": {
          "description": "Climate parameters; rules compute temperature and moisture by latitude, season and altitude.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equator_temperature_c",
            "pole_temperature_c"
          ],
          "properties": {
            "equator_temperature_c": {
              "description": "Annual mean sea-level temperature at the equator.",
              "type": "number"
            },
            "pole_temperature_c": {
              "description": "Annual mean sea-level temperature at the poles.",
              "type": "number"
            },
            "moisture": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall wetness, 0 (none) to 1 (very wet)."
            }
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "orbit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semi_major_axis_km",
        "eccentricity"
      ],
      "properties": {
        "semi_major_axis_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "eccentricity": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "inclination_deg": {
          "type": "number"
        },
        "ascending_node_deg": {
          "type": "number"
        },
        "arg_periapsis_deg": {
          "type": "number"
        },
        "mean_anomaly_deg": {
          "type": "number",
          "description": "Position along the orbit at universe time 0."
        }
      }
    },
    "rgb": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
