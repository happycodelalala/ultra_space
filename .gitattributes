# Normalize text files to LF so Windows tools don't create line-ending noise
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ktx2 binary
*.dds binary
*.exr binary
*.hdr binary
*.glb binary
*.blend binary
*.fbx binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
